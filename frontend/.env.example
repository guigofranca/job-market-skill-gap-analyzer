# Copie para .env.local e ajuste. ATENÇÃO: toda variável VITE_* é embutida no bundle
# e fica visível para qualquer usuário do site — nunca coloque segredos aqui.

# URL base da API (backend FastAPI). Apenas http(s), sem barra final.
VITE_API_BASE_URL=http://localhost:8000

# Tempo máximo de espera por resposta da API, em milissegundos (1000-60000).
VITE_API_TIMEOUT_MS=15000
