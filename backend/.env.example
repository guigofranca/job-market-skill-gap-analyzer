# Copie para backend/.env e ajuste. O arquivo .env real NUNCA deve ser versionado
# (já está no .gitignore). Todas as variáveis são opcionais: sem elas valem os padrões seguros.

# ---------------------------------------------------------------- Geral
ENVIRONMENT=development           # development | test | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
# DATA_DIR=data                   # relativo à pasta backend/ ou caminho absoluto
MAX_JOB_AGE_DAYS=180              # vagas mais antigas são descartadas no processamento

# ---------------------------------------------------------------- Cliente HTTP (coleta)
REQUEST_DELAY_SECONDS=1.0         # intervalo mínimo entre requisições (seja educado com as APIs)
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_MAX_RESPONSE_MB=20
# Identifique seu projeto no User-Agent (boa prática ao consumir APIs públicas):
HTTP_USER_AGENT=JobMarketSkillGapAnalyzer/0.1 (educational portfolio project; +https://github.com/guigofranca/job-market-skill-gap-analyzer)

# ---------------------------------------------------------------- Fontes de vagas
ENABLED_SOURCES=gupy,solides   # todas do Brasil, nenhuma exige chave

GUPY_API_URL=https://portal.gupy.io/api/job-search/jobs
GUPY_MAX_PAGES_PER_QUERY=2
# GUPY_SEARCH_TERMS=dados,analista de dados,automacao,desenvolvedor

SOLIDES_API_URL=https://vagas.solides.com.br/api/vacancies
SOLIDES_MAX_PAGES_PER_QUERY=20    # 10 vagas por página, mais recentes primeiro


# ---------------------------------------------------------------- API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173        # origens permitidas, separadas por vírgula
API_ALLOWED_HOSTS=localhost,127.0.0.1         # cabeçalho Host aceito
API_RATE_LIMIT_PER_MINUTE=300                 # por IP (cada mudança de filtro faz ~8 requisições)
API_ENABLE_DOCS=true                          # /docs (sempre desligado em production)
